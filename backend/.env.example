# Copy to backend/.env and fill in values. Never commit .env.
# Everything except DATABASE_URL is optional. Each feature turns on when its key is set.

# Required. Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/job_autopilot
DATABASE_URL=

# --- AI ---
# Claude reads your resume, scores jobs, summarises employers and reads alert emails.
# Without it, the app uses free keyword matching.
# AI keys are read only from this file, so a key set elsewhere on your computer is never billed.
ANTHROPIC_API_KEY=
RESUME_MODEL=claude-sonnet-5-5
SCORING_MODEL=claude-haiku-5-5
TAILOR_MODEL=claude-haiku-5-5
MAX_AI_SCORES_PER_RUN=30

# Gemini embeddings rank jobs. Only your titles, skills and industries are sent.
# Free-tier data may be used by Google.
GOOGLE_API_KEY=

# --- Job sources ---
# Company careers boards need no key. Add them on the My resume profile page.

# Trade Me Jobs. Production apps are reviewed by Trade Me.
# For the sandbox, use https://api.tmsandbox.co.nz
TRADEME_BASE_URL=https://api.trademe.co.nz
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
# Member token. Add these if Trade Me rejects calls made with only the consumer key.
TRADEME_TOKEN=
TRADEME_TOKEN_SECRET=

# Gmail job alerts (SEEK, LinkedIn, Indeed), read-only over IMAP. Also needs ANTHROPIC_API_KEY.
# Turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# --- Employer research (shortlisted jobs only) ---
GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=
MAX_EMPLOYER_PROFILES_PER_RUN=10

# --- Google Maps employers ---
MAX_DISCOVERY_SEARCHES_PER_RUN=3
MAX_EMPLOYER_SITES_PER_RUN=8
MAX_NEARBY_SEARCHES_PER_DAY=30

# --- Daily search, while the backend is running ---
SCHEDULER_ENABLED=true
DAILY_SEARCH_HOUR=7

# Later phases (not read by the code yet)
# NZBN_API_KEY=
# OPENAI_API_KEY=
# OMNIDIM_API_KEY=
